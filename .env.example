# ---- PayPal sandbox (dedicated app; never use live credentials) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox account emails used by the seed and the sandbox gate script
SANDBOX_CIRCLE_EMAIL=
SANDBOX_MEMBER_EMAILS=member1@example.com,member2@example.com,member3@example.com,member4@example.com,member5@example.com,member6@example.com,member7@example.com,member8@example.com

# ---- Model (Azure OpenAI by default; any tool-calling model works) ----
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
MODEL_LABEL=azure-openai/<deployment>   # shown in the audit drawer and README

# ---- AG Grid Enterprise (AI Toolkit) ----
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# ---- Database ----
DATABASE_URL=postgresql://turnwise:turnwise@localhost:5432/turnwise

# ---- Demo clock: seconds of real time per circle day (0 = real time) ----
DEMO_SECONDS_PER_DAY=0.7

# ---- MCP endpoint ----
MCP_PORT=3001
