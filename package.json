{
  "name": "turnwise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "AI treasurer for savings circles, built on PayPal. Agents propose; a deterministic policy gate executes every money move.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "sandbox:gate": "tsx --env-file=.env scripts/sandbox-gate.ts",
    "redteam": "tsx --env-file-if-exists=.env red-team/run.ts",
    "evals": "tsx --env-file-if-exists=.env evals/report.ts",
    "vault:test": "tsx --env-file=.env scripts/vault-test.ts",
    "money:loop": "tsx --env-file=.env scripts/money-loop.ts",
    "demo:circle": "tsx --env-file=.env scripts/demo-circle.ts",
    "reconcile": "tsx --env-file=.env scripts/reconcile.ts",
    "mcp:token": "tsx --env-file=.env scripts/mcp-token.ts",
    "payout:status": "tsx --env-file-if-exists=.env scripts/payout-status.ts",
    "vaults:export": "tsx --env-file=.env scripts/vaults-export.ts",
    "mcp:smoke": "tsx --env-file-if-exists=.env scripts/mcp-smoke.ts",
    "circles:tidy": "tsx --env-file-if-exists=.env scripts/circles-tidy.ts",
    "webhooks:check": "tsx --env-file-if-exists=.env scripts/webhooks-check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "^6.19.3",
    "ag-charts-community": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ai": "^4.3.19",
    "ajv": "^8.20.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
