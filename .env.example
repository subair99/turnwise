# Copy to .env and fill in. Never commit .env. Use a dedicated PayPal SANDBOX app only.

# ---- PayPal sandbox (US business app) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox PERSONAL accounts used as circle members (US accounts can receive payouts). 2 to 8, comma-separated, one line.
SANDBOX_MEMBER_EMAILS=
# Saved wallets for those members, so a hosted Judge mode can start a live circle: printed by `pnpm vaults:export`.
# Treat like a password.
SANDBOX_VAULTS=

# ---- Model (any tool-calling model via OpenRouter, OpenAI-compatible API) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# ---- AG Grid Enterprise (AI Toolkit, Integrated Charts). Without a key the grid works with a watermark. One line. ----
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# ---- Database (docker compose maps Postgres to 5433 on the host) ----
DATABASE_URL=postgresql://turnwise:turnwise@localhost:5433/turnwise

# ---- Public base URL: PayPal return/cancel links and the MCP endpoint shown to members ----
APP_BASE_URL=http://localhost:3000
# Optional: override the MCP URL shown to members (default: $APP_BASE_URL/api/mcp)
MCP_PUBLIC_URL=

# ---- MCP bid tokens (16+ characters; required in production) ----
MCP_TOKEN_SECRET=

# ---- Demo clock for scripts (seconds of real time per circle day; 0 = real time). Live circles keep their own clock. ----
DEMO_SECONDS_PER_DAY=0.7
# How long a sealed auction stays open on a demo clock, in real seconds
AUCTION_MIN_SECONDS=20
# Worker tick in milliseconds
WORKER_TICK_MS=2000

# ---- Standalone MCP server (local only; the web app also serves /api/mcp) ----
MCP_PORT=3001
